'use client';

import React, { useState, useMemo } from 'react';
import Link from 'next/link';
import { createBrowserClient } from '@supabase/ssr';

export interface AziendaRecord {
  id: string;
  ragione_sociale: string;
  codice_azienda?: string | null;
  partita_iva?: string | null;
  citta?: string | null;
  nazione?: string | null;
  referente?: string | null;
  email?: string | null;
  advisor_nome?: string | null;
  fatturato?: number | null;
  contratti_attivi?: number | null;
  stato?: string | null;
}

interface AziendeListManagerProps {
  initialAziende: AziendaRecord[];
  onDeleted?: (id: string) => void;
}

export function AziendeListManager({
  initialAziende,
  onDeleted,
}: AziendeListManagerProps) {
  const supabase = useMemo(
    () =>
      createBrowserClient(
        process.env.NEXT_PUBLIC_SUPABASE_URL!,
        process.env.NEXT_PUBLIC_SUPABASE_ANON_KEY!
      ),
    []
  );

  const [aziende, setAziende] = useState<AziendaRecord[]>(initialAziende);
  const [searchQuery, setSearchQuery] = useState('');
  const [targetToDelete, setTargetToDelete] = useState<AziendaRecord | null>(null);
  const [deleting, setDeleting] = useState(false);
  const [feedback, setFeedback] = useState<{
    type: 'success' | 'error';
    text: string;
  } | null>(null);

  React.useEffect(() => {
    setAziende(initialAziende);
  }, [initialAziende]);

  const filteredAziende = useMemo(() => {
    const q = searchQuery.trim().toLowerCase();
    if (!q) return aziende;

    return aziende.filter((az) => {
      const haystack = [
        az.ragione_sociale,
        az.codice_azienda,
        az.partita_iva,
        az.citta,
        az.nazione,
        az.referente,
        az.email,
        az.advisor_nome,
        az.stato,
      ]
        .filter(Boolean)
        .join(' ')
        .toLowerCase();

      return haystack.includes(q);
    });
  }, [aziende, searchQuery]);

  const handleConfirmDelete = async () => {
    if (!targetToDelete) return;
    setDeleting(true);
    setFeedback(null);

    try {
      const { error } = await supabase
        .from('gos_aziende')
        .delete()
        .eq('id', targetToDelete.id);

      if (error) throw error;

      const deletedId = targetToDelete.id;
      const deletedName = targetToDelete.ragione_sociale;

      setAziende((prev) => prev.filter((item) => item.id !== deletedId));
      onDeleted?.(deletedId);
      setTargetToDelete(null);
      setFeedback({
        type: 'success',
        text: `Azienda "${deletedName}" eliminata definitivamente.`,
      });
    } catch (err: unknown) {
      const msg =
        err instanceof Error ? err.message : 'Errore durante l’eliminazione dell’azienda.';
      setFeedback({ type: 'error', text: msg });
    } finally {
      setDeleting(false);
    }
  };

  return (
    <div className="w-full space-y-3">
      {/* Barra ricerca e contatore */}
      <div className="bg-[#0F172A] border border-[#1E293B] p-[10px] flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2">
        <div className="flex-1 flex items-center gap-2">
          <input
            type="text"
            value={searchQuery}
            onChange={(e) => setSearchQuery(e.target.value)}
            placeholder="Cerca per ragione sociale, codice AZ-XXXXX, P.IVA, città, referente o email..."
            className="w-full bg-[#050B14] border border-[#1E293B] px-3 py-2 text-xs text-white focus:outline-none focus:border-[#EA580C]"
          />
          {searchQuery && (
            <button
              type="button"
              onClick={() => setSearchQuery('')}
              className="px-2.5 py-2 bg-[#1E293B] hover:bg-[#334155] border border-[#334155] text-xs font-bold text-[#94A3B8] hover:text-white cursor-pointer"
            >
              Reset
            </button>
          )}
        </div>

        <div className="text-xs text-[#94A3B8] whitespace-nowrap">
          Visualizzate: <strong className="text-white">{filteredAziende.length}</strong> /{' '}
          <strong className="text-white">{aziende.length}</strong>
        </div>
      </div>

      {feedback && (
        <div
          className={`p-[10px] border text-xs font-bold ${
            feedback.type === 'success'
              ? 'bg-emerald-950/50 border-emerald-700 text-emerald-300'
              : 'bg-red-950/50 border-red-700 text-red-300'
          }`}
        >
          {feedback.text}
        </div>
      )}

      {/* Elenco aziende */}
      <div className="bg-[#0F172A] border border-[#1E293B] divide-y divide-[#1E293B]">
        {filteredAziende.length === 0 ? (
          <div className="p-4 text-center text-xs text-[#94A3B8]">
            Nessuna azienda trovata con i criteri di ricerca attuali.
          </div>
        ) : (
          filteredAziende.map((az) => (
            <div
              key={az.id}
              className="p-[10px] flex flex-col md:flex-row md:items-center md:justify-between gap-3 hover:bg-[#050B14]/40"
            >
              <div className="min-w-0">
                <div className="font-bold text-sm text-white truncate">
                  {az.ragione_sociale}
                </div>
                <div className="text-xs text-amber-300 font-semibold">
                  {az.codice_azienda || az.id}
                  {az.citta ? ` · ${az.citta}` : ''}
                  {az.partita_iva ? ` · P.IVA ${az.partita_iva}` : ''}
                </div>
              </div>

              <div className="text-xs text-[#94A3B8]">
                {az.advisor_nome ? (
                  <>
                    <div className="text-white font-semibold">{az.advisor_nome}</div>
                    <div>Referente / Contatto: {az.referente || az.email || '—'}</div>
                  </>
                ) : (
                  <div>Referente / Contatto: {az.referente || az.email || '—'}</div>
                )}
              </div>

              <div className="flex flex-wrap items-center gap-3 text-xs">
                {typeof az.fatturato === 'number' && (
                  <span className="font-bold text-emerald-400">
                    € {az.fatturato.toLocaleString('it-IT')}
                  </span>
                )}
                {typeof az.contratti_attivi === 'number' && (
                  <span className="px-2 py-1 bg-[#1E293B] border border-[#334155] text-white font-semibold">
                    {az.contratti_attivi} Attivi
                  </span>
                )}
                {az.stato && (
                  <span className="px-2 py-1 bg-emerald-950 border border-emerald-700 text-emerald-300 font-bold">
                    {az.stato}
                  </span>
                )}

                <Link
                  href={`/aziende/${az.id}`}
                  className="px-2.5 py-1.5 bg-[#1E293B] hover:bg-[#334155] border border-[#334155] text-xs font-bold text-white"
                >
                  Dettagli
                </Link>

                <button
                  type="button"
                  onClick={() => setTargetToDelete(az)}
                  className="px-2.5 py-1.5 bg-red-950/70 hover:bg-red-800 border border-red-700 text-xs font-bold text-red-200 cursor-pointer"
                >
                  Elimina
                </button>
              </div>
            </div>
          ))
        )}
      </div>

      {/* Alert di conferma cancellazione irreversibile */}
      {targetToDelete && (
        <div className="fixed inset-0 z-50 bg-black/80 flex items-center justify-center p-[10px]">
          <div className="w-full max-w-md bg-[#0F172A] border border-red-600 p-4 space-y-4">
            <div className="space-y-1">
              <div className="text-xs font-extrabold uppercase tracking-wider text-red-400">
                Attenzione — Azione Irreversibile
              </div>
              <h2 className="text-base font-bold text-white">
                Sei veramente sicuro di voler cancellare questa azienda?
              </h2>
              <p className="text-xs text-[#94A3B8]">
                Stai per eliminare definitivamente{' '}
                <strong className="text-white">{targetToDelete.ragione_sociale}</strong>
                {targetToDelete.codice_azienda ? ` (${targetToDelete.codice_azienda})` : ''}.
                L&apos;operazione non può essere annullata.
              </p>
            </div>

            <div className="flex items-center justify-end gap-2">
              <button
                type="button"
                disabled={deleting}
                onClick={() => setTargetToDelete(null)}
                className="px-3 py-2 bg-[#1E293B] hover:bg-[#334155] border border-[#334155] text-xs font-bold text-white cursor-pointer"
              >
                Annulla
              </button>
              <button
                type="button"
                disabled={deleting}
                onClick={handleConfirmDelete}
                className="px-3 py-2 bg-red-600 hover:bg-red-700 disabled:opacity-50 border border-red-500 text-xs font-extrabold uppercase text-white cursor-pointer"
              >
                {deleting ? 'Eliminazione...' : 'Sì, cancella definitivamente'}
              </button>
            </div>
          </div>
        </div>
      )}
    </div>
  );
}

export default AziendeListManager;
